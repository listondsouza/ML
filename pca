
import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler

# Step 1: Create dataset
df = pd.DataFrame({
    'A': [2, 4, 6, 8, 10],
    'B': [4, 8, 12, 16, 20],
    'C': [1, 3, 5, 7, 9]
})

print("Original Data:")
print(df)

# Step 2: Standardize data
scaler = StandardScaler()
X = scaler.fit_transform(df)

print("\nStandardized Data:")
print(X)

# Step 3: Calculate covariance matrix
cov_matrix = np.cov(X.T)

print("\nCovariance Matrix:")
print(cov_matrix)

# Step 4: Calculate eigenvalues and eigenvectors
eigenvalues, eigenvectors = np.linalg.eigh(cov_matrix)

print("\nEigenvalues:")
print(eigenvalues)

print("\nEigenvectors:")
print(eigenvectors)

# Step 5: Select first 2 principal components
components = eigenvectors[:, -2:]

# Step 6: Transform data
X_pca = np.dot(X, components)

print("\nTransformed Data:")
print(X_pca)

# Step 7: Reconstruct standardized data
X_reconstructed = np.dot(X_pca, components.T)

print("\nReconstructed Standardized Data:")
print(X_reconstructed)

# Step 8: Convert back to original scale
original_reconstructed = scaler.inverse_transform(
    X_reconstructed
)

print("\nReconstructed Original Data:")
print(original_reconstructed)
